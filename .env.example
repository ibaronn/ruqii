# ـــــــــــــــــــ التطوير المحلي (SQLite) ـــــــــــــــــــ
DATABASE_URL="file:./dev.db"

# ـــــــــــــــــــ الإنتاج (Vercel) ـــــــــــــــــــ
# Postgres (Neon): الرابط المباشر غير المُجمّع — يُستخدم لـ prisma db push/seed
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Postgres (Neon): الرابط المُجمّع (pooled) للاتصالات المتعددة مع الـ serverless
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# أعد ضبط الأنواع حسب اختيارك أعلاه (DATABASE_URL=pooled مقابل DIRECT_URL=direct)

# تخزين الصور على Vercel Blob (راجع Vercel > Storage > Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# حساب الأدمن (يُستخدم في طبقة الـ seed تلقائيًا عند النشر)
ADMIN_USERNAME="ruqi"
ADMIN_PASSWORD="Ruqi2026!Admin"
ADMIN_NAME="رُقي"

# مفتاح توقيع JWT (غيّره لقيمة عشوائية طويلة)
ADMIN_JWT_SECRET="change-this-to-a-long-random-secret-string-in-production"

# ===== إشعار واتساب التلقائي للمتجر (اختياري — يعمل حتى بدون إعداده) =====
# فعّل فقط إن أردت استقبال إشعار الطلبات على واتساب تلقائيًا عبر WhatsApp Cloud API:
# 1) سجّل تطبيقًا في developers.facebook.com وأضف منتج WhatsApp (مجاني).
# 2) اختر الرقم الذي سيرسل منه المتجر (سيتوقف WhatsApp Cloud عن العمل إن لم يفعّل الرقم).
# 3) أنشئ رمز وصول نظام (System User Token) بصفحة Meta ونسخه هنا.
WHATSAPP_ACCESS_TOKEN=""
# رقم معرف الفون الذي سيرسل منه المتجر (يظهر في نظرة عامة التطبيق في Meta)
WHATSAPP_PHONE_NUMBER_ID=""
# أرقام مديري المتجر بصيغة دولية بلا + أو مسافات، مفصولة بفاصلة: 9665XXXXXXXX,9665YYYYYYYY
ADMIN_WHATSAPP_PHONES=""
